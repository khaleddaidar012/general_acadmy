{
  "name": "academy-general-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "node scripts/check-cloudflare.cjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply academy-general-demo --local",
    "db:migrate:remote": "node scripts/check-cloudflare.cjs && wrangler d1 migrations apply academy-general-demo --remote",
    "push": "git push -u origin HEAD",
    "check": "tsc --noEmit",
    "seed:demo": "node scripts/seed-demo.cjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "rate-limiter-flexible": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "wrangler": "^4.150.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
